@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model CMS.Backend.ViewModel.PaginationViewModel<CMS.Data.Entities.Category>
<h2 class="text-primary mb-3">
    DANH SÁCH DANH MỤC
</h2>

<div class="mb-3">
    <a href="/Category/Create"
       class="btn btn-success">
        + Thêm danh mục
    </a>
</div>
<form method="get" class="row mb-3">

    <div class="col-md-4">
        <input name="keyword"
               value="@Model.Keyword"
               class="form-control"
               placeholder="Nhập tên danh mục..." />
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary">
            Tìm kiếm
        </button>
    </div>

</form>
<table class="table table-bordered table-hover">

    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tên danh mục</th>
            <th>Mô tả</th>
            <th width="220">Chức năng</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.Items)
        {
            <tr>

                <td>@item.Id</td>

                <td>@item.Name</td>

                <td>@item.Description</td>

                <td>

                    <a href="/Category/Details/@item.Id"
                       class="btn btn-info btn-sm">
                        Chi tiết
                    </a>

                    <a href="/Category/Edit/@item.Id"
                       class="btn btn-warning btn-sm">
                        Sửa
                    </a>

                    <a href="/Category/Delete/@item.Id"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Bạn có chắc muốn xóa?')">
                        Xóa
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>
<nav class="mt-4">

    <ul class="pagination justify-content-center">

        @if (Model.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-keyword="@Model.Keyword">
                    &laquo;
                </a>
            </li>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">

                <a class="page-link"
                   asp-route-page="@i"
                   asp-route-keyword="@Model.Keyword">
                    @i
                </a>

            </li>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-keyword="@Model.Keyword">
                    &raquo;
                </a>
            </li>
        }

    </ul>

</nav>