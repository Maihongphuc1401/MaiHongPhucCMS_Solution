@model CMS.Data.Entities.Category

<h2>SỬA DANH MỤC</h2>

<form method="post">

    <input type="hidden"
           asp-for="Id" />

    <div class="mb-3">
        <label>Tên danh mục</label>

        <input asp-for="Name"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Mô tả</label>

        <textarea asp-for="Description"
                  class="form-control">
        </textarea>
    </div>

    <button class="btn btn-warning">
        Cập nhật
    </button>

</form>