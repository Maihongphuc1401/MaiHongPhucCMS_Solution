@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model IEnumerable<CMS.Data.Entities.Customer>

<h2 class="text-primary">
    DANH SÁCH KHÁCH HÀNG
</h2>

<a asp-action="Create"
   class="btn btn-success mb-3">
    Thêm khách hàng
</a>

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>SĐT</th>
            <th>Địa chỉ</th>
            <th width="120">Chức năng</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>

                <td>@item.FullName</td>

                <td>@item.Email</td>

                <td>@item.Phone</td>

                <td>@item.Address</td>

                <td>
                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>