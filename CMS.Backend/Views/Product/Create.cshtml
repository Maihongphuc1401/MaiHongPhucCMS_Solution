@model CMS.Data.Entities.Product
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="text-success mb-3">
    THÊM SẢN PHẨM
</h2>

<form method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <!-- Hiện lỗi tổng -->
    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <label>Tên sản phẩm</label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label>Mô tả</label>

        <textarea asp-for="Description"
                  class="form-control"></textarea>

        <span asp-validation-for="Description"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label>Giá</label>

        <input asp-for="Price"
               class="form-control" />

        <span asp-validation-for="Price"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label>Số lượng</label>

        <input asp-for="StockQuantity"
               class="form-control" />

        <span asp-validation-for="StockQuantity"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label>Hình ảnh</label>

        <input type="file"
               name="imageFile"
               class="form-control"
               accept=".jpg,.jpeg,.png" />
    </div>

    <div class="mb-3">
        <label>Danh mục</label>

        <select asp-for="CategoryProductId"
                class="form-control">

            <option value="">
                -- Chọn danh mục --
            </option>

            @foreach (var item in ViewBag.CategoryProducts)
            {
                <option value="@item.Id">
                    @item.Name
                </option>
            }

        </select>

        <span asp-validation-for="CategoryProductId"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Thêm sản phẩm
    </button>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}