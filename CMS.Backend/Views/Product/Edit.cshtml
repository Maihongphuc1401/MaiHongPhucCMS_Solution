@model CMS.Data.Entities.Product
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2 class="text-warning mb-3">
    SỬA SẢN PHẨM
</h2>

<form method="post"
      enctype="multipart/form-data">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Tên sản phẩm</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Mô tả</label>
        <textarea asp-for="Description"
                  class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label>Giá</label>
        <input asp-for="Price"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Số lượng</label>
        <input asp-for="StockQuantity"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Ảnh hiện tại</label>
        <br />

        <img src="@Model.ImageUrl"
             width="150"
             class="img-thumbnail" />
    </div>

    <div class="mb-3">
        <label>Chọn ảnh mới</label>

        <input type="file"
               name="imageFile"
               class="form-control"
               accept=".jpg,.jpeg,.png" />
    </div>

    <div class="mb-3">
        <label>Danh mục</label>

        <select asp-for="CategoryProductId"
                class="form-control">

            @foreach (var item in ViewBag.CategoryProducts)
            {
                <option value="@item.Id"
                        selected="@(item.Id == Model.CategoryProductId)">
                    @item.Name
                </option>
            }

        </select>
    </div>

    <button type="submit"
            class="btn btn-warning">
        Cập nhật
    </button>

</form>