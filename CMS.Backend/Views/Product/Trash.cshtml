@model CMS.Backend.ViewModel.PaginationViewModel<CMS.Data.Entities.Product>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="text-danger mb-3">
    THÙNG RÁC SẢN PHẨM
</h2>

<a asp-action="Index"
   class="btn btn-primary mb-3">
    Quay lại
</a>

<form method="get" class="row mb-3">

    <div class="col-md-4">
        <input type="text"
               name="keyword"
               class="form-control"
               placeholder="Tên sản phẩm..."
               value="@Model.Keyword" />
    </div>

    <div class="col-md-3">

        <select name="categoryId"
                class="form-select">

            <option value="0">
                Tất cả danh mục
            </option>

            @foreach (var c in ViewBag.CategoryProducts)
            {
                <option value="@c.Id">
                    @c.Name
                </option>
            }

        </select>

    </div>

    <div class="col-md-2">
        <button class="btn btn-success">
            Tìm kiếm
        </button>
    </div>

</form>

<table class="table table-bordered">

    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tên sản phẩm</th>
            <th>Hình ảnh</th>
            <th width="250">Chức năng</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.Items)
        {
            <tr>

                <td>@item.Id</td>

                <td>@item.Name</td>

                <td>
                    <img src="@item.ImageUrl"
                         width="100" />
                </td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        Chi tiết
                    </a>

                    <a asp-action="Restore"
                       asp-route-id="@item.Id"
                       class="btn btn-success btn-sm">
                        Khôi phục
                    </a>

                    <a asp-action="Destroy"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Xóa vĩnh viễn?')">
                        Xóa vĩnh viễn
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>