@model CMS.Data.Entities.Product

<h2 class="text-primary mb-3">
    CHI TIẾT SẢN PHẨM
</h2>

<div class="card p-3">

    <img src="@Model.ImageUrl"
         width="250"
         class="mb-3" />

    <h3>@Model.Name</h3>

    <p>
        <strong>Giá:</strong>
        @Model.Price.ToString("N0") VNĐ
    </p>

    <p>
        <strong>Số lượng:</strong>
        @Model.StockQuantity
    </p>

    <p>
        <strong>Mô tả:</strong>
        @Model.Description
    </p>

    <p>
        <strong>Danh mục:</strong>
        @Model.CategoryProduct?.Name
    </p>

</div>