@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@model CMS.Backend.ViewModel.PaginationViewModel<CMS.Data.Entities.Product>

<h2 class="text-primary mb-3">
    DANH SÁCH SẢN PHẨM
</h2>

<a asp-action="Create"
   class="btn btn-success mb-3">
    Thêm sản phẩm
</a>

<a asp-action="Trash"
   class="btn btn-danger mb-3">
    Thùng rác
</a>
<form method="get">
    <div class="row">

        <div class="col-md-4">
            <input name="keyword"
                   value="@Model.Keyword"
                   class="form-control"
                   placeholder="Tên sản phẩm..." />
        </div>

        <div class="col-md-3">
            <select name="categoryId" class="form-select">

                <option value="0">Tất cả danh mục</option>

                @foreach (var c in ViewBag.CategoryProducts)
                {
                    <option value="@c.Id"
                            selected="@(ViewBag.CategoryId == c.Id)">
                        @c.Name
                    </option>
                }

            </select>
        </div>

        <div class="col-md-2">
            <button class="btn btn-success">
                Tìm kiếm
            </button>
        </div>

    </div>
</form>
<table class="table table-bordered table-hover">

    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Hình</th>
            <th>Tên sản phẩm</th>
            <th>Giá</th>
            <th>Số lượng</th>
            <th>Danh mục</th>
            <th width="250">Chức năng</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.Items)
        {
            <tr>

                <td>@item.Id</td>

                <td>
                    <img src="@item.ImageUrl"
                         width="100"
                         class="img-thumbnail" />
                </td>

                <td>@item.Name</td>

                <td>
                    @item.Price.ToString("N0") VNĐ
                </td>

                <td>@item.StockQuantity</td>

                <td>@item.CategoryProduct?.Name</td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        Chi tiết
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Sửa
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Đưa vào thùng rác?')">
                        Xóa
                    </a>

                </td>

            </tr>
        }

    </tbody>
</table>
<nav class="mt-3">
    <ul class="pagination">

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@i"
                   asp-route-keyword="@Model.Keyword"
                   asp-route-categoryId="@ViewBag.CategoryId">
                    @i
                </a>

            </li>
        }

    </ul>
</nav>