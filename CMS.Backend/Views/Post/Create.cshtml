@model CMS.Data.Entities.Post

<h2 class="text-success">
    THÊM BÀI VIẾT
</h2>

<form method="post"
      enctype="multipart/form-data">

    <div class="mb-3">
        <label>Tiêu đề</label>
        <input asp-for="Title"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Nội dung</label>
        <textarea asp-for="Content"
                  class="form-control"
                  rows="5"></textarea>
    </div>

    <div class="mb-3">
        <label>Hình ảnh</label>

        <input type="file"
               name="imageFile"
               class="form-control"
               accept=".jpg,.jpeg,.png" />
    </div>

    <div class="mb-3">
        <label>Danh mục</label>

        <select asp-for="CategoryId"
                class="form-control">

            @foreach (var item in ViewBag.Categories)
            {
                <option value="@item.Id">
                    @item.Name
                </option>
            }

        </select>
    </div>

    <button type="submit"
            class="btn btn-success">
        Thêm bài viết
    </button>

</form>