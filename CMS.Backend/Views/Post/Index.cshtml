@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model CMS.Backend.ViewModel.PaginationViewModel<CMS.Data.Entities.Post>
<h2 class="text-primary mb-3">
    DANH SÁCH BÀI VIẾT
</h2>

<div class="mb-3">
    <a href="/Post/Create" class="btn btn-success">
        + Thêm bài viết
    </a>
</div>
<form method="get" class="row mb-3">

    <div class="col-md-4">
        <input name="keyword"
               class="form-control"
               value="@Model.Keyword"
               placeholder="Nhập tiêu đề bài viết..." />
    </div>

    <div class="col-md-2">
        <button class="btn btn-success">
            Tìm kiếm
        </button>
    </div>

</form>
<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Hình ảnh</th>
            <th>Tiêu đề</th>
            <th>Nội dung</th>
            <th>Ngày tạo</th>
            <th>Category</th>
            <th width="220">Chức năng</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>

                <td>@item.Id</td>

                <td>
                    <img src="@item.ImageUrl"
                         width="120"
                         class="img-thumbnail" />
                </td>

                <td>@item.Title</td>

                <td>@item.Content</td>

                <td>
                    @item.CreatedDate.ToString("dd/MM/yyyy")
                </td>

                <td>@item.Category?.Name</td>

                <td>

                    <a href="/Post/Details/@item.Id"
                       class="btn btn-info btn-sm">
                        Chi tiết
                    </a>

                    <a href="/Post/Edit/@item.Id"
                       class="btn btn-warning btn-sm">
                        Sửa
                    </a>

                    <a href="/Post/Delete/@item.Id"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Bạn có chắc muốn xóa?')">
                        Xóa
                    </a>

                </td>

            </tr>
        }
    </tbody>
</table>
<nav class="mt-3">

    <ul class="pagination justify-content-center">

        @if (Model.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-keyword="@Model.Keyword">
                    &laquo;
                </a>
            </li>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">

                <a class="page-link"
                   asp-route-page="@i"
                   asp-route-keyword="@Model.Keyword">
                    @i
                </a>

            </li>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-keyword="@Model.Keyword">
                    &raquo;
                </a>
            </li>
        }

    </ul>

</nav>