@model CMS.Data.Entities.Post

<h2>SỬA BÀI VIẾT</h2>

<form method="post">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Tiêu đề</label>
        <input asp-for="Title"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Nội dung</label>
        <textarea asp-for="Content"
                  class="form-control">
        </textarea>
    </div>

    <div class="mb-3">
        <label>Link hình ảnh</label>
        <input asp-for="ImageUrl"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>CategoryId</label>
        <input asp-for="CategoryId"
               class="form-control" />
    </div>

    <button class="btn btn-warning">
        Cập nhật
    </button>

</form>