@model CMS.Data.Entities.User

<h2>Chi tiết User</h2>

<table class="table table-bordered">

    <tr>
        <th>ID</th>
        <td>@Model.Id</td>
    </tr>

    <tr>
        <th>Username</th>
        <td>@Model.Username</td>
    </tr>

    <tr>
        <th>Họ tên</th>
        <td>@Model.FullName</td>
    </tr>

    <tr>
        <th>Vai trò</th>
        <td>@Model.Role</td>
    </tr>

</table>

<a asp-action="Index" class="btn btn-secondary">
    Quay lại
</a>