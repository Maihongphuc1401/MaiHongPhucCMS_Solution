@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@model CMS.Backend.ViewModel.PaginationViewModel<CMS.Data.Entities.User>

<h2 class="text-success mb-3">
    DANH SÁCH NGƯỜI DÙNG
</h2>

<div class="mb-3">
    <a href="/User/Create" class="btn btn-success">
        + Thêm người dùng
    </a>
</div>

<form method="get" class="row mb-3">
    <div class="col-md-4">
        <input name="keyword"
               value="@Model.Keyword"
               class="form-control"
               placeholder="Nhập tên hoặc tài khoản..." />
    </div>
    <div class="col-md-2">
        <button class="btn btn-success">
            Tìm kiếm
        </button>
    </div>
</form>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tên đăng nhập</th>
            <th>Mật khẩu</th>
            <th>Họ tên</th>
            <th>Vai trò</th>
            <th width="220">Chức năng</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Username</td>
                <td><span class="text-muted">••••••••</span></td>
                <td>@item.FullName</td>
                <td>
                    @if (item.Role == "Quản trị viên")
                    {
                        <span class="badge bg-danger">@item.Role</span>
                    }
                    else
                    {
                        <span class="badge bg-primary">@item.Role</span>
                    }
                </td>
                <td>
                    <a href="/User/Details/@item.Id" class="btn btn-info btn-sm">Chi tiết</a>
                    <a href="/User/Edit/@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                    <a href="/User/Delete/@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa?')">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav class="mt-3">
    <ul class="pagination justify-content-center">
        @if (Model.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-route-page="@(Model.CurrentPage - 1)" asp-route-keyword="@Model.Keyword">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>
        }
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link" asp-route-page="@i" asp-route-keyword="@Model.Keyword">@i</a>
            </li>
        }
        @if (Model.CurrentPage < Model.TotalPages)
        {
            <li class="page-item">
                <a class="page-link" asp-route-page="@(Model.CurrentPage + 1)" asp-route-keyword="@Model.Keyword">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        }
    </ul>
</nav>