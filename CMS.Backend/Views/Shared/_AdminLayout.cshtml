<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <title>CMS ADMIN</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>

        body {
            background: #f4f7fe;
            overflow-x: hidden;
        }

        .sidebar {
            width: 260px;
            height: 100vh;
            background: white;
            position: fixed;
            left: 0;
            top: 0;
            padding: 20px;
            border-right: 1px solid #ddd;
        }

        .logo {
            font-size: 28px;
            font-weight: bold;
            color: #2563eb;
            margin-bottom: 40px;
        }

        .sidebar a {
            display: block;
            padding: 14px;
            border-radius: 10px;
            margin-bottom: 10px;
            color: #333;
            text-decoration: none;
            font-weight: 500;
            transition: 0.3s;
        }

        .sidebar a:hover {
            background: #2563eb;
            color: white;
        }

        .main {
            margin-left: 270px;
            padding: 30px;
        }

        .topbar {
            background: white;
            padding: 15px 20px;
            border-radius: 15px;
            margin-bottom: 25px;
        }

        .card-dashboard {
            border: none;
            border-radius: 20px;
            padding: 20px;
            color: white;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .bg-blue {
            background: linear-gradient(45deg,#2563eb,#3b82f6);
        }

        .bg-green {
            background: linear-gradient(45deg,#059669,#10b981);
        }

        .bg-orange {
            background: linear-gradient(45deg,#ea580c,#f97316);
        }

        .bg-red {
            background: linear-gradient(45deg,#dc2626,#ef4444);
        }

    </style>

</head>

<body>

    <!-- SIDEBAR -->

    <div class="sidebar">

        <div class="logo">
            CMS ADMIN
        </div>

        <a href="/Home">
            <i class="bi bi-speedometer2"></i>
            Dashboard
        </a>

        <a href="/Category">
            <i class="bi bi-folder"></i>
            Category
        </a>

        <a href="/Post">
            <i class="bi bi-newspaper"></i>
            Post
        </a>

        <a href="/CategoryProduct">
            <i class="bi bi-grid"></i>
            Category Product
        </a>

        <a href="/Product">
            <i class="bi bi-bag"></i>
            Product
        </a>

        <a href="/Customer">
            <i class="bi bi-people"></i>
            Customer
        </a>

        <a href="/Order">
            <i class="bi bi-cart"></i>
            Order
        </a>

        <a href="/User">
            <i class="bi bi-person-circle"></i>
            User
        </a>

    </div>

    <!-- MAIN -->

    <div class="main">

        <!-- TOPBAR -->

        <div class="topbar d-flex justify-content-between align-items-center">

            <h4>
                Dashboard
            </h4>

            <div>
                Xin chào, <b>Mai Hồng Phúc</b>
            </div>

        </div>

        @RenderBody()

    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>