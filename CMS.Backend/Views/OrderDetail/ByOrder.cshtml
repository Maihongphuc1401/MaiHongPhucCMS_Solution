@model IEnumerable<CMS.Data.Entities.OrderDetail>

<h2 class="text-primary mb-4">
    CHI TIẾT ĐƠN HÀNG #@ViewBag.OrderId
</h2>

<table class="table table-bordered table-hover">

    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Id</td>

                <td>@item.Product?.Name</td>

                <td>@item.Quantity</td>

                <td>
                    @item.UnitPrice.ToString("N0") VNĐ
                </td>

                <td>
                    @((item.Quantity * item.UnitPrice).ToString("N0")) VNĐ
                </td>

            </tr>
        }

    </tbody>

</table>

<a asp-controller="Order"
   asp-action="Index"
   class="btn btn-secondary">
    Quay lại
</a>